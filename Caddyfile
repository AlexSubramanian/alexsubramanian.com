alexsubramanian.com {
    handle /v1/update {
        reverse_proxy watchtower:8080
    }

    # The admin control plane. Cloudflare Access protects the /admin path at the
    # edge, so a request only reaches here with a valid session -- but admin-api
    # verifies the Cf-Access-Jwt-Assertion header itself as well, so a request
    # that somehow arrives without going through Access still gets a 403.
    #
    # strip_prefix rather than handle_path: admin-api serves /api/*, so
    # /admin/api/overview has to arrive as /api/overview, not /overview.
    handle /admin/api/* {
        uri strip_prefix /admin
        reverse_proxy admin-api:8000
    }

    # STAGE A -- temporary. Echoes the client certificate Cloudflare presented,
    # so we can see whether origin pulls are live before enforcing them.
    # Removed in stage B.
    handle /aop-check {
        respond "client-cert-subject: {http.request.tls.client.subject}" 200
    }

    handle {
        root * /srv/site
        file_server
        encode gzip
    }

    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem {
        client_auth {
            # STAGE A -- temporary. Verifies Cloudflare's origin-pull
            # certificate when one is presented, but does not require it, so
            # this cannot reject any traffic. It exists purely to confirm that
            # Authenticated Origin Pulls is actually switched on at the edge
            # before we start requiring a certificate. Promote to
            # require_and_verify in stage B.
            mode verify_if_given
            trust_pool file /etc/caddy/certs/cf-aop-ca.pem
        }
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output file /var/log/caddy/access.log
        format json
    }
}

www.alexsubramanian.com {
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
    redir https://alexsubramanian.com{uri} permanent
}
