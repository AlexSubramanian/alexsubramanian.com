alexsubramanian.com {
    handle /v1/update {
        reverse_proxy watchtower:8080
    }

    # The admin control plane. Cloudflare Access protects the /admin path at the
    # edge, so a request only reaches here with a valid session -- but admin-api
    # verifies the Cf-Access-Jwt-Assertion header itself as well, so a request
    # that somehow arrives without going through Access still gets a 403.
    #
    # strip_prefix rather than handle_path: admin-api serves /api/*, so
    # /admin/api/overview has to arrive as /api/overview, not /overview.
    handle /admin/api/* {
        uri strip_prefix /admin
        reverse_proxy admin-api:8000
    }

    handle {
        root * /srv/site
        file_server
        encode gzip
    }

    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem {
        # Authenticated Origin Pulls. Cloudflare presents a client certificate
        # on every connection to this origin; anything that bypasses Cloudflare
        # and connects to the origin IP directly fails the TLS handshake,
        # before a single HTTP request is parsed.
        #
        # This is why /admin is safe: Cloudflare Access only protects requests
        # that actually go through Cloudflare, and admin-api's own JWT check is
        # application code. This moves the boundary down to TLS.
        #
        # Caveat: the zone-wide toggle uses Cloudflare's SHARED origin-pull
        # certificate, so this proves "came from Cloudflare", not "came from
        # this zone". Uploading a per-zone certificate closes that.
        #
        # Operational footgun: if Cloudflare is ever paused or the DNS record
        # grey-clouded, no certificate is presented and this origin stops
        # answering until Authenticated Origin Pulls is turned off too.
        client_auth {
            mode require_and_verify
            trust_pool file /etc/caddy/certs/cf-aop-ca.pem
        }
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output file /var/log/caddy/access.log
        format json
    }
}

www.alexsubramanian.com {
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem {
        client_auth {
            mode require_and_verify
            trust_pool file /etc/caddy/certs/cf-aop-ca.pem
        }
    }
    redir https://alexsubramanian.com{uri} permanent
}
